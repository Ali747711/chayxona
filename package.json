{
  "name": "chayxona",
  "version": "0.4.0",
  "description": "Local-first terminal collaboration room where Claude Code, Codex, and Google Antigravity CLIs debate and cross-review code live.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "chayxona": "./bin/chayxona.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "ink": "^5.1.0",
    "ink-text-input": "^6.0.0",
    "pino": "^9.6.0",
    "react": "^18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
