{
  "name": "chayxona",
  "version": "0.6.0",
  "description": "Local-first terminal collaboration room where Claude Code, Codex, and Google Antigravity CLIs debate and cross-review code live.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "chayxona": "bin/chayxona.mjs"
  },
  "files": [
    "dist",
    "bin",
    "action.yml",
    "README.md",
    "LICENSE",
    "DESIGN.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "ink": "^5.1.0",
    "ink-text-input": "^6.0.0",
    "pino": "^9.6.0",
    "react": "^18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ali747711/chayxona.git"
  },
  "homepage": "https://github.com/Ali747711/chayxona#readme",
  "bugs": {
    "url": "https://github.com/Ali747711/chayxona/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "multi-agent",
    "cli",
    "tui",
    "claude-code",
    "codex",
    "antigravity",
    "code-review",
    "mcp",
    "debate"
  ]
}
